{
  "name": "zeqouxtraining",
  "productName": "ZeqouXTraining",
  "version": "2.0.0",
  "description": "ZeqouXTraining — local-first AI model training, fine-tuning and deployment studio",
  "main": "electron/main.js",
  "author": "Zeqou <misakolot6@gmail.com>",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "python python/tests/test_engine.py",
    "smoke": "electron scripts/smoke.mjs",
    "launch": "electron scripts/launch.mjs",
    "verify": "npm run typecheck && npm run test && npm run smoke",
    "verify:app": "npm run build && npm run launch",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "update-server": "node scripts/update-server.mjs",
    "update-manifest": "node scripts/make-update-manifest.mjs",
    "cert": "node scripts/make-cert.mjs",
    "pack": "node scripts/dist.mjs --dir",
    "dist": "node scripts/dist.mjs",
    "dist:signed": "node scripts/dist.mjs --sign"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "ai.zeqou.xtraining",
    "productName": "ZeqouXTraining",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mishaadevv",
        "repo": "xtraining",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "ico.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "ico.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "ico.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "ico.png",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.venv/**",
          "!**/tests/**"
        ]
      }
    ]
  }
}
